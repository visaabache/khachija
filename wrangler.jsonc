// Cloudflare Worker for the Khachija store. See README.md for first-time setup.
{
  "name": "khachija",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker renders the storefront pages itself and passes /assets/* and /admin/* on to the static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khachija",
      // Create it with: npx wrangler d1 create khachija, then paste the printed id here.
      "database_id": "c7b15f00-4de1-4db9-aa35-fa00c8e25c87",
      "migrations_dir": "migrations"
    }
  ],
  // The shop's public address, used for canonical links, the sitemap, PayPal's return address and emails.
  // Once khachija-shop.de is on this Cloudflare account, set it and uncomment the routes.
  "vars": { "SITE_URL": "https://khachija-shop.de" },
  "routes": [
    { "pattern": "khachija-shop.de", "custom_domain": true },
    { "pattern": "www.khachija-shop.de", "custom_domain": true },
    { "pattern": "webmail.khachija-shop.de", "custom_domain": true }
  ],
  // Cloudflare rate limiter: at most 120 API requests a minute per visitor (stricter limits for orders and
  // logins are in the code). Free on all plans.
  "ratelimits": [{ "name": "RATE_LIMIT", "namespace_id": "4210", "simple": { "limit": 120, "period": 60 } }],
  // Preview URLs for single versions are off, so only the deployed shop answers.
  "preview_urls": false,
  "workers_dev": false,
  "observability": { "enabled": true }
}
